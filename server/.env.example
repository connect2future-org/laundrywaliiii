# Server Environment Configuration
NODE_ENV=development
PORT=5001

# MongoDB Atlas Connection (Must point strictly to the separate LaundryWalii database)
# Replace placeholders with your Laundry Waliiii MongoDB user (e.g. laundrywaliiii) & password
# If your password contains special characters (@, :, /, ?, #, etc.), URL-encode them first
MONGO_URI=mongodb+srv://<LAUNDRY_WALII_DB_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/LaundryWalii?retryWrites=true&w=majority
MONGODB_DB_NAME=LaundryWalii

# Authentication Secrets (Minimum 32-character cryptographically random strings; never commit real secrets)
JWT_SECRET=<REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET>
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=<REPLACE_WITH_DISTINCT_MIN_32_CHAR_ADMIN_SECRET>
ADMIN_JWT_EXPIRES_IN=12h

# CORS Allowed Origins (Comma-separated list of frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5177

# Rate Limiting Defaults
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Optional Payment Gateway Placeholders (Integrate in payment phase)
PAYMENT_GATEWAY_KEY_ID=<OPTIONAL_PAYMENT_KEY_ID>
PAYMENT_GATEWAY_KEY_SECRET=<OPTIONAL_PAYMENT_KEY_SECRET>
PAYMENT_WEBHOOK_SECRET=<OPTIONAL_WEBHOOK_SECRET>

# SMTP Email Notifications (Required to send order & contact enquiry notifications)
SMTP_HOST=<OPTIONAL_SMTP_HOST>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<OPTIONAL_SMTP_USERNAME>
SMTP_PASS=<OPTIONAL_SMTP_PASSWORD>
SMTP_FROM=<OPTIONAL_SENDER_EMAIL>
CONTACT_NOTIFICATION_EMAIL=hr@connect2future.com

# WhatsApp Business API Notifications (Highest Priority)
# Destination business WhatsApp number where alerts should be received (default: 919035999272)
WHATSAPP_NOTIFY_NUMBER=919035999272

# Option A: Meta WhatsApp Cloud API (Recommended official provider)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=<OPTIONAL_META_WHATSAPP_SYSTEM_USER_ACCESS_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<OPTIONAL_META_PHONE_NUMBER_ID>
WHATSAPP_BUSINESS_ACCOUNT_ID=<OPTIONAL_META_WABA_ID>

# Option B: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=<OPTIONAL_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<OPTIONAL_TWILIO_AUTH_TOKEN>
TWILIO_WHATSAPP_FROM=+14155238886

# Option C: Custom WhatsApp Webhook / Gateway
WHATSAPP_WEBHOOK_URL=<OPTIONAL_WEBHOOK_URL>

# SMS Gateway Notifications (Optional)
SMS_PROVIDER=none
SMS_API_KEY=<OPTIONAL_SMS_GATEWAY_KEY>
SMS_SENDER_ID=<OPTIONAL_SMS_SENDER_ID>
SMS_NOTIFY_NUMBER=919035999272
