{
  "name": "laundrywalii-api",
  "version": "1.0.0",
  "description": "Independent backend API server for Laundry Waliiii using Node.js, Express, ESM, and Mongoose (LaundryWalii database)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDatabase.js",
    "db:seed": "node src/scripts/seedCatalogue.js",
    "admin:bootstrap": "node src/scripts/createSuperAdmin.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
